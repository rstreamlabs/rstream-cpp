@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

macro(find_boost_dependency)
  find_package(Boost ${ARGN} CONFIG QUIET)
  if(NOT Boost_FOUND)
    if(POLICY CMP0167)
      cmake_policy(PUSH)
      cmake_policy(SET CMP0167 OLD)
    endif()
    find_package(Boost ${ARGN} QUIET)
    if(POLICY CMP0167)
      cmake_policy(POP)
    endif()
  endif()
  if(NOT Boost_FOUND)
    message(FATAL_ERROR "Required Boost dependencies for rstream were not found")
  endif()
endmacro()

if(EMSCRIPTEN)
  find_boost_dependency()
else()
  find_boost_dependency(COMPONENTS filesystem system date_time regex url random OPTIONAL_COMPONENTS coroutine thread)
endif()
find_dependency(CompatProtobuf QUIET)
if(@WITH_MAXMINDDB@)
  find_package(maxminddb QUIET)
  if(NOT maxminddb_FOUND)
    message(FATAL_ERROR "Required maxminddb dependency for rstream was not found")
  endif()
endif()
if(@WITH_NCURSES@)
  find_dependency(Curses)
  if(CURSES_FOUND AND NOT TARGET Curses::Curses)
    add_library(Curses::Curses INTERFACE IMPORTED GLOBAL)
    set(RSTREAM_CURSES_INCLUDE_DIRS ${CURSES_INCLUDE_DIRS})
    if(APPLE)
      list(FILTER RSTREAM_CURSES_INCLUDE_DIRS EXCLUDE REGEX "\\.sdk/usr/include/?$")
    endif()
    if(RSTREAM_CURSES_INCLUDE_DIRS)
      set_property(TARGET Curses::Curses PROPERTY INTERFACE_INCLUDE_DIRECTORIES ${RSTREAM_CURSES_INCLUDE_DIRS})
    endif()
    set_property(TARGET Curses::Curses PROPERTY INTERFACE_LINK_LIBRARIES ${CURSES_LIBRARIES})
    unset(RSTREAM_CURSES_INCLUDE_DIRS)
  endif()
endif()
find_dependency(nlohmann_json)
if(@SSL_PROVIDER@ STREQUAL "openssl")
  if(APPLE)
    if(NOT OpenSSL_DIR)
      find_program(HOMEBREW brew)
      if(HOMEBREW STREQUAL "HOMEBREW-NOTFOUND")
        message(WARNING "homebrew not found : not using homebrew's OpenSSL version")
        if(NOT OPENSSL_ROOT_DIR)
          message(WARNING "use -DOPENSSL_ROOT_DIR for non-Apple OpenSSL")
        endif()
      else()
        execute_process(COMMAND brew --prefix openssl@3
          OUTPUT_VARIABLE OPENSSL_ROOT_DIR
          OUTPUT_STRIP_TRAILING_WHITESPACE)
      endif()
    endif()
  endif()
  find_package(OpenSSL REQUIRED)
elseif(@SSL_PROVIDER@ STREQUAL "libressl")
  find_package(LibreSSL REQUIRED)
endif()
find_dependency(spdlog)
find_dependency(Threads)
find_dependency(yaml-cpp)

if(MSVC)
  add_compile_definitions(BOOST_ALL_NO_LIB)
endif()

check_required_components(rstream)

include("${CMAKE_CURRENT_LIST_DIR}/@CMAKE_PACKAGE_TARGETS@.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/@CMAKE_PACKAGE_NAME@Plugins.cmake")
message(STATUS "Found @PROJECT_NAME@ (@PROJECT_VERSION@)")
