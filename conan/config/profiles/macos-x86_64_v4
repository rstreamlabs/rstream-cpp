include(default)

{% set compiler_target_cpu = "x86-64-v4" %}

[settings]
os=Macos
os.version=11.0
arch=x86_64
compiler.cppstd=20
compiler.libcxx=libc++
compiler.target={{ compiler_target_cpu }}
build_type=Release
[options]
[tool_requires]
[conf]
tools.build.cross_building:can_run=False
[buildenv]
CFLAGS=-arch x86_64 -march={{ compiler_target_cpu }} -mtune=generic
CXXFLAGS=-arch x86_64 -march={{ compiler_target_cpu }} -mtune=generic
CC=/usr/bin/clang
CXX=/usr/bin/clang++
