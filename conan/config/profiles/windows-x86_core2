include(default)

{% set compiler_target_cpu = "core2" %}

[settings]
arch=x86
build_type=Release
compiler=gcc
compiler.cppstd=20
compiler.libcxx=libstdc++11
compiler.threads=posix
compiler.version=13
compiler.target={{ compiler_target_cpu }}
os=Windows
[options]
[buildenv]
CC=i686-w64-mingw32-gcc -march={{ compiler_target_cpu }} -mtune=generic
CXX=i686-w64-mingw32-g++ -march={{ compiler_target_cpu }} -mtune=generic
CPP=i686-w64-mingw32-cpp
AR=i686-w64-mingw32-ar
AS=i686-w64-mingw32-as
GDB=i686-w64-mingw32-gdb
LD=i686-w64-mingw32-ld
NM=i686-w64-mingw32-nm
OBJCOPY=i686-w64-mingw32-objcopy
OBJDUMP=i686-w64-mingw32-objdump
RANLIB=i686-w64-mingw32-ranlib
SIZE=i686-w64-mingw32-size
STRINGS=i686-w64-mingw32-strings
STRIP=i686-w64-mingw32-strip
GCOV=i686-w64-mingw32-gcov
RC=i686-w64-mingw32-windres
DLLTOOL=i686-w64-mingw32-dlltool
