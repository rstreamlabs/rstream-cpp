include(default)

{% set compiler_target_cpu = "core2" %}
{% set compiler_target_triplet = "i686-w64-windows-gnu" %}

[settings]
arch=x86
build_type=Release
compiler=clang
compiler.cppstd=20
compiler.libcxx=libc++
compiler.version=21
compiler.target={{ compiler_target_triplet }}
os=Windows
[options]
[buildenv]
CPPFLAGS=-DFMT_CONSTEVAL=
CFLAGS=-march={{ compiler_target_cpu }} -mtune=generic
CXXFLAGS=-march={{ compiler_target_cpu }} -mtune=generic -DFMT_CONSTEVAL= -pthread
LDFLAGS=-pthread
CC=/opt/llvm-mingw/bin/i686-w64-mingw32-gcc
CXX=/opt/llvm-mingw/bin/i686-w64-mingw32-g++
CPP=/opt/llvm-mingw/bin/i686-w64-mingw32-gcc -E
AR=/opt/llvm-mingw/bin/i686-w64-mingw32-ar
AS=/opt/llvm-mingw/bin/i686-w64-mingw32-as
LD=/opt/llvm-mingw/bin/i686-w64-mingw32-ld
NM=/opt/llvm-mingw/bin/i686-w64-mingw32-nm
OBJCOPY=/opt/llvm-mingw/bin/i686-w64-mingw32-objcopy
OBJDUMP=/opt/llvm-mingw/bin/i686-w64-mingw32-objdump
RANLIB=/opt/llvm-mingw/bin/i686-w64-mingw32-ranlib
SIZE=/opt/llvm-mingw/bin/i686-w64-mingw32-size
STRINGS=/opt/llvm-mingw/bin/i686-w64-mingw32-strings
STRIP=/opt/llvm-mingw/bin/i686-w64-mingw32-strip
RC=/opt/llvm-mingw/bin/i686-w64-mingw32-windres
DLLTOOL=/opt/llvm-mingw/bin/i686-w64-mingw32-dlltool
